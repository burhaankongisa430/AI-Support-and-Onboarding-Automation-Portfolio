# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Airtable personal access token — https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_CLIENTS_TABLE=Clients

# SendGrid API key — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG...

# From address used in outbound welcome emails
FROM_EMAIL=welcome@yourcompany.com
FROM_NAME=Your Company Name

# Slack incoming webhook URL — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
