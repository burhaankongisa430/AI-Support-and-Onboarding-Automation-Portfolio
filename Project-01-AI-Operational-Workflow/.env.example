# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Airtable personal access token — https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat...

# Your Airtable Base ID (found in the API docs for your base)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Name of the table inside the base (default: "Support Tickets")
AIRTABLE_TABLE_NAME=Support Tickets
